# Environnement du CLI octl pour l'émulateur feint du lab, tel que l'affiche
# `feint env outscale` (feint v0.13.0). Identifiants FICTIFS : feint ne
# vérifie aucune signature. L'adresse porte déjà /api/v1, la forme que lit
# octl. Usage : source feint-outscale.env
export OSC_ACCESS_KEY='AAAAAAAAAAAAAAAAAAAA'
export OSC_ENDPOINT_API='http://127.0.0.1:4599/api/v1'
export OSC_PROTOCOL='http'
export OSC_REGION='eu-west-2'
export OSC_SECRET_KEY='BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB'
